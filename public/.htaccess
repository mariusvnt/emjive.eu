# Apache config for the OVH host. Edit it here, never on the server: the deploy
# mirrors dist/ with --delete. Every block is in <IfModule> so a missing module
# skips its directives instead of failing the whole site.

Options -Indexes
ServerSignature Off

# ---- HTTPS and a single host name ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex (canonical host https://emjive.eu).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http -> https. X-Forwarded-Proto covers a TLS-terminating proxy, where
  # %{HTTPS} is "off" even for secure requests.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ---- Clean URLs ----
  #   /gallery            index.html (/ serves it too, via DirectoryIndex)
  #   /<page>             <page>.html
  #   /<slug>             an item's page, dist/<slug>.html (emitItemPages in vite.config.js)
  # Mirrored by cleanUrls() in vite.config.js for the dev and preview servers.
  # THE_REQUEST matches only what the client asked for, so the redirects below
  # never loop with the internal rewrites.

  RewriteCond %{THE_REQUEST} \s/index\.html[?\s]
  RewriteRule ^index\.html$ /gallery [L,R=301]

  # /<page>.html -> /<page>. Not product.html (js/product.js redirects
  # ?id= links to /<slug> itself) nor 404.html (the ErrorDocument).
  RewriteCond %{THE_REQUEST} \s/[^/?\s]+\.html[?\s]
  RewriteRule ^(?!(?:product|404)\.html$)([^/]+)\.html$ /$1 [L,R=301]

  # No trailing slash: pages reference css/, js/, assets/ relatively. Real
  # directories are left to mod_dir.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Internal: /gallery is index.html, /<name> is <name>.html when it exists;
  # anything else is a real 404.
  RewriteRule ^gallery$ index.html [L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)$ $1.html [L]
</IfModule>

# ---- MIME types ----
# A wrong .wasm type breaks streaming compilation of the Draco decoder.
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/wasm  .wasm
  AddType application/octet-stream .hdr
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType application/javascript .js .mjs
  AddCharset UTF-8 .html .css .js .json .svg .xml .txt
</IfModule>

# ---- Compression ----
# .glb/.hdr/.wasm compress poorly but still gain.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/wasm
  <FilesMatch "\.(hdr|glb)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# ---- Caching ----
# Content-hashed bundles under /assets/: a year, immutable. HTML/JS/CSS/JSON
# with fixed names: always revalidate, so a deploy never mixes old and new.
# Unhashed binaries (models, images, HDRIs): see below; they keep their names
# when regenerated, so a change needed sooner requires a new filename.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|json|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(glb|hdr|wasm|webp|png|jpe?g|svg|ico|woff2)$">
    # TEMPORARY during development: 5 hours. Target once the models settle:
    # "public, max-age=604800, stale-while-revalidate=86400".
    Header set Cache-Control "public, max-age=18000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2|svg|webp)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # ---- Security headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "DENY"

  # HSTS starts short, as a cached max-age is hard to take back. Raise to
  # 31536000 (and consider includeSubDomains) once HTTPS has run a while.
  Header always set Strict-Transport-Security "max-age=300"

  # Report-Only until a clean pass on every page, then rename to
  # Content-Security-Policy. Non-'self' sources:
  #   img-src data: blob:   the stylesheet's inline SVG masks
  #   worker-src blob:      three's Draco loader worker
  #   wasm-unsafe-eval      compiling the Draco decoder
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ---- Errors ----
# 404.html uses only absolute URLs, so it renders at any path depth.
ErrorDocument 404 /404.html
