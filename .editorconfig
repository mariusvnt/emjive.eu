root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The product/series JSON is hand-aligned into columns (see
# dev-guidelines/data.md) — don't let an editor re-flow it.
[data/**.json]
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
